{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/../thou_hooks.py\" user-prompt goose",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/../thou_hooks.py\" session-end goose",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:developer__)?(?:shell|write|edit|tree|read_image)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/../thou_hooks.py\" pre-tool-use goose",
            "timeout": 10,
            "on_failure": "block"
          }
        ]
      }
    ]
  }
}
